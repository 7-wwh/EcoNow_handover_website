<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>EcoNow 25/26 — Handover Report</title>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Big+Shoulders+Display:wght@500;700;900&family=Literata:ital,opsz,wght@0,18..144,400;0,18..144,500;0,18..144,600;1,18..144,400&family=Space+Mono:wght@400;700&display=swap" rel="stylesheet">
<style>
  :root{
    --ink:#241d15;
    --oil:#3c2f20;
    --wick:#150f0a;
    --wax:#c07a2e;
    --wax-light:#e3a758;
    --wax-pale:#f2c98a;
    --sage:#6d7a56;
    --sage-dark:#4d5940;
    --paper:#ece2cd;
    --paper-deep:#ddcfae;
    --cream:#f6efdf;
    --receipt:#fbf6ea;
    --line:rgba(36,29,21,0.16);
  }

  *{box-sizing:border-box;}
  html{scroll-behavior:smooth;}
  body{
    margin:0;
    background:var(--cream);
    color:var(--ink);
    font-family:'Literata',serif;
    font-size:17px;
    line-height:1.7;
    -webkit-font-smoothing:antialiased;
  }

  ::selection{background:var(--wax-pale);color:var(--ink);}

  h1,h2,h3,.label{
    font-family:'Big Shoulders Display',sans-serif;
    text-transform:uppercase;
    letter-spacing:0.02em;
  }

  .mono{font-family:'Space Mono',monospace;}

  a{color:var(--sage-dark);}

  /* ---------- burn rail (scroll progress) ---------- */
  #burnRail{
    position:fixed;
    right:22px;
    top:50%;
    transform:translateY(-50%);
    width:14px;
    height:220px;
    z-index:50;
    display:flex;
    flex-direction:column;
    align-items:center;
  }
  #burnRail .flame{
    width:8px;height:8px;border-radius:50% 50% 50% 50%/60% 60% 40% 40%;
    background:radial-gradient(circle at 50% 30%, #fff2c9, var(--wax-light) 60%, var(--wax) 100%);
    box-shadow:0 0 8px 2px rgba(224,164,80,0.55);
    margin-bottom:2px;
    flex-shrink:0;
  }
  #burnRail .stick{
    width:6px;
    flex:1;
    background:linear-gradient(var(--wax-pale), var(--cream));
    border:1px solid var(--line);
    border-radius:3px;
    position:relative;
    overflow:hidden;
  }
  #burnRail .stick .burned{
    position:absolute;bottom:0;left:0;right:0;
    background:var(--wick);
    height:0%;
    transition:height 0.15s linear;
  }
  @media (max-width:900px){ #burnRail{display:none;} }

  /* ---------- liquid glass nav ---------- */
  .glass-defs{position:absolute;width:0;height:0;overflow:hidden;}

  .liquid-nav{
    position:fixed;
    z-index:200;
    top:18px;
    left:50%;
    transform:translateX(-50%);
    display:flex;
    align-items:center;
    gap:2px;
    max-width:min(92vw, 620px);
    padding:6px;
    border-radius:999px;
    overflow-x:auto;
    scrollbar-width:none;
    -ms-overflow-style:none;
    background-color:color-mix(in srgb, var(--wax-pale) 16%, transparent);
    backdrop-filter:blur(9px) url(#liquidGlass) saturate(160%);
    -webkit-backdrop-filter:blur(9px) saturate(160%);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--cream) 14%, transparent),
      inset 1.6px 2.6px 0px -2px color-mix(in srgb, var(--cream) 75%, transparent),
      inset -2px -2px 0px -2px color-mix(in srgb, var(--cream) 55%, transparent),
      inset -0.4px -1px 4px 0px color-mix(in srgb, var(--wick) 30%, transparent),
      inset 0px 3px 4px -2px color-mix(in srgb, var(--wick) 24%, transparent),
      0px 10px 26px -6px rgba(0,0,0,0.5);
  }
  .liquid-nav::-webkit-scrollbar{display:none;}

  .liquid-nav__indicator{
    position:absolute;
    top:6px; bottom:6px; left:6px;
    width:0;
    border-radius:999px;
    background-color:color-mix(in srgb, var(--wax) 60%, transparent);
    box-shadow:
      inset 0 0 0 1px color-mix(in srgb, var(--wax-light) 40%, transparent),
      0 2px 8px -2px rgba(0,0,0,0.4);
    transform:translateX(0);
    transition:transform 420ms cubic-bezier(0.65,0,0.35,1), width 420ms cubic-bezier(0.65,0,0.35,1);
    z-index:1;
    pointer-events:none;
  }

  .liquid-nav__link{
    position:relative;
    z-index:2;
    padding:9px 15px;
    border-radius:999px;
    font-family:'Space Mono',monospace;
    font-size:11.5px;
    letter-spacing:0.07em;
    text-transform:uppercase;
    white-space:nowrap;
    color:var(--paper-deep);
    text-decoration:none;
    transition:color 220ms ease;
  }
  .liquid-nav__link:hover{color:#fff;}
  .liquid-nav__link.active{color:var(--ink);font-weight:700;}

  @media (max-width:640px){
    .liquid-nav{top:12px;padding:5px;gap:0;}
    .liquid-nav__link{padding:8px 12px;font-size:10.5px;}
  }

  /* ---------- layout shells ---------- */
  .wrap{max-width:760px;margin:0 auto;padding:0 28px;}
  section{padding:88px 0;}
  .dark{background:var(--ink);color:var(--paper);}
  .dark .wrap{color:var(--paper);}
  .eyebrow{
    font-family:'Space Mono',monospace;
    font-size:12.5px;
    letter-spacing:0.18em;
    text-transform:uppercase;
    color:var(--wax);
    display:flex;
    align-items:center;
    gap:10px;
    margin-bottom:18px;
  }
  .eyebrow::before{content:"";width:26px;height:1px;background:var(--wax);}

  /* ---------- hero ---------- */
  .hero{
    background:
      radial-gradient(ellipse at 20% -10%, rgba(224,164,80,0.35), transparent 55%),
      var(--ink);
    color:var(--paper);
    padding:120px 0 90px;
    position:relative;
    overflow:hidden;
  }
  .hero::after{
    content:"";
    position:absolute;
    inset:auto 0 0 0;
    height:1px;
    background:linear-gradient(90deg, transparent, var(--wax), transparent);
  }
  .hero .kicker{
    font-family:'Space Mono',monospace;
    font-size:13px;
    letter-spacing:0.2em;
    text-transform:uppercase;
    color:var(--wax-light);
    margin:0 0 26px;
  }
  .hero h1{
    font-size:clamp(38px, 7vw, 68px);
    font-weight:900;
    line-height:0.98;
    margin:0 0 30px;
    max-width:11ch;
  }
  .hero h1 em{
    font-style:normal;
    color:var(--wax-light);
  }
  .hero p.lede{
    font-family:'Literata',serif;
    font-size:19px;
    max-width:46ch;
    color:var(--paper-deep);
    margin:0 0 40px;
  }
  .stamp{
    display:inline-flex;
    align-items:center;
    gap:14px;
    font-family:'Space Mono',monospace;
    font-size:12px;
    letter-spacing:0.08em;
    color:var(--paper-deep);
    border:1px solid rgba(236,226,205,0.28);
    padding:10px 16px;
    border-radius:2px;
  }
  .stamp .dot{width:6px;height:6px;border-radius:50%;background:var(--wax);}

  /* ---------- headings ---------- */
  h2.section-title{
    font-size:clamp(30px, 4.5vw, 44px);
    font-weight:700;
    line-height:1.02;
    margin:0 0 10px;
  }
  .section-sub{
    font-family:'Literata',serif;
    font-style:italic;
    color:var(--oil);
    opacity:0.75;
    font-size:16px;
    margin:0 0 44px;
  }
  .dark .section-sub{color:var(--paper-deep);opacity:0.85;}

  p{margin:0 0 20px;}
  strong{color:var(--wax);font-weight:600;}
  .dark strong{color:var(--wax-light);}

  /* ---------- quote callout ---------- */
  blockquote{
    margin:34px 0;
    padding:22px 26px;
    border-left:3px solid var(--wax);
    background:rgba(224,164,80,0.08);
    font-style:italic;
    font-size:18px;
    border-radius:0 4px 4px 0;
  }
  blockquote cite{
    display:block;
    margin-top:10px;
    font-family:'Space Mono',monospace;
    font-style:normal;
    font-size:12px;
    letter-spacing:0.06em;
    text-transform:uppercase;
    color:var(--sage-dark);
  }

  /* ---------- timeline (real chronology → numbered is earned) ---------- */
  .timeline{margin:44px 0 0;position:relative;}
  .timeline::before{
    content:"";
    position:absolute;
    left:19px;top:6px;bottom:6px;
    width:1px;
    background:linear-gradient(var(--wax), var(--sage) 60%, transparent);
  }
  .tl-item{
    position:relative;
    padding:0 0 40px 56px;
  }
  .tl-item:last-child{padding-bottom:0;}
  .tl-item::before{
    content:attr(data-n);
    position:absolute;left:0;top:-2px;
    width:40px;height:40px;
    border-radius:50%;
    background:var(--paper);
    border:1px solid var(--line);
    display:flex;align-items:center;justify-content:center;
    font-family:'Space Mono',monospace;
    font-size:12px;color:var(--oil);
  }
  .tl-item.active::before{
    background:var(--wax);
    border-color:var(--wax);
    color:#fff;
  }
  .tl-item h3{
    font-size:22px;
    margin:2px 0 8px;
    font-weight:700;
    text-transform:none;
  }
  .tl-item .tag{
    font-family:'Space Mono',monospace;
    font-size:11px;
    letter-spacing:0.08em;
    text-transform:uppercase;
    color:var(--sage-dark);
    background:rgba(109,122,86,0.12);
    padding:3px 8px;
    border-radius:20px;
    margin-left:10px;
  }

  /* ---------- receipt / signature element ---------- */
  .receipt-frame{
    margin:44px auto 0;
    max-width:420px;
    background:var(--receipt);
    color:var(--ink);
    padding:30px 26px 26px;
    box-shadow:0 22px 44px -18px rgba(0,0,0,0.45);
    position:relative;
    transform:rotate(-1.1deg);
  }
  .receipt-frame::before,
  .receipt-frame::after{
    content:"";
    position:absolute;left:0;right:0;height:10px;
    background:
      radial-gradient(circle at 6px 5px, var(--ink) 5px, transparent 5.5px) repeat-x;
    background-size:16px 10px;
  }
  .receipt-frame::before{top:-5px;}
  .receipt-frame::after{bottom:-5px;transform:scaleY(-1);}
  .receipt-frame h4{
    font-family:'Space Mono',monospace;
    text-align:center;
    font-size:13px;
    letter-spacing:0.14em;
    text-transform:uppercase;
    margin:0 0 4px;
  }
  .receipt-frame .sub{
    text-align:center;font-family:'Space Mono',monospace;
    font-size:11px;color:#7a6f5c;margin-bottom:18px;
  }
  .receipt-line{
    display:flex;justify-content:space-between;gap:12px;
    font-family:'Space Mono',monospace;
    font-size:13px;
    padding:7px 0;
    border-bottom:1px dashed var(--line);
  }
  .receipt-line span:first-child{color:#5a5040;}
  .receipt-line.total{
    border-bottom:none;
    border-top:2px solid var(--ink);
    margin-top:6px;
    padding-top:12px;
    font-size:15px;
    font-weight:700;
  }
  .receipt-line.neg span:last-child{color:#a53d2b;}

  /* ---------- constraint cards ---------- */
  .card{
    background:var(--paper);
    border:1px solid var(--line);
    border-radius:6px;
    padding:26px 28px;
    margin:22px 0;
  }
  .card h4{
    margin:0 0 14px;
    font-size:13px;
    font-family:'Space Mono',monospace;
    letter-spacing:0.1em;
    text-transform:uppercase;
    color:var(--sage-dark);
    display:flex;align-items:center;gap:10px;
  }
  .card h4::before{content:"";width:8px;height:8px;background:var(--sage);border-radius:2px;flex-shrink:0;}
  .card ul{margin:0;padding-left:20px;}
  .card li{margin-bottom:10px;}
  .card li:last-child{margin-bottom:0;}

  /* ---------- fill-in placeholder ---------- */
  .fillin{
    border:1.5px dashed rgba(109,122,86,0.55);
    border-radius:6px;
    padding:22px 24px;
    margin:22px 0;
    color:var(--sage-dark);
    background:repeating-linear-gradient(135deg, rgba(109,122,86,0.05) 0 10px, transparent 10px 20px);
  }
  .fillin .ft-label{
    font-family:'Space Mono',monospace;
    font-size:11px;
    letter-spacing:0.1em;
    text-transform:uppercase;
    margin-bottom:6px;
    display:block;
  }
  .fillin p{margin:0;font-style:italic;opacity:0.85;}

  /* ---------- two-column do / don't ---------- */
  .split{display:grid;grid-template-columns:1fr 1fr;gap:22px;margin:28px 0;}
  @media (max-width:640px){.split{grid-template-columns:1fr;}}
  .split .col{
    border-radius:6px;
    padding:24px 24px 20px;
  }
  .split .col.do{background:rgba(109,122,86,0.10);border:1px solid rgba(109,122,86,0.3);}
  .split .col.dont{background:rgba(165,61,43,0.07);border:1px solid rgba(165,61,43,0.22);}
  .split h4{
    font-family:'Space Mono',monospace;
    font-size:12px;letter-spacing:0.1em;text-transform:uppercase;
    margin:0 0 12px;
  }
  .split .col.do h4{color:var(--sage-dark);}
  .split .col.dont h4{color:#a53d2b;}

  /* ---------- divider ---------- */
  .wax-divider{
    display:flex;align-items:center;gap:16px;
    margin:6px 0 0;
    color:var(--wax);
    opacity:0.7;
  }
  .wax-divider::before,.wax-divider::after{content:"";flex:1;height:1px;background:currentColor;opacity:0.3;}

  /* ---------- closing / seal ---------- */
  .closing{
    background:var(--ink);
    color:var(--paper);
    text-align:center;
    padding:110px 0 90px;
  }
  .seal{
    width:96px;height:96px;
    border-radius:50%;
    border:2px solid var(--wax);
    display:flex;align-items:center;justify-content:center;
    margin:0 auto 30px;
    font-family:'Big Shoulders Display',sans-serif;
    font-weight:900;
    font-size:22px;
    color:var(--wax-light);
    letter-spacing:0.02em;
    box-shadow:0 0 0 6px rgba(224,164,80,0.08), 0 0 30px rgba(224,164,80,0.25);
  }
  .closing h2{font-size:clamp(26px,4vw,36px);max-width:20ch;margin:0 auto 20px;}
  .closing .lede{max-width:44ch;margin:0 auto 8px;color:var(--paper-deep);font-style:italic;}

  footer{
    background:var(--ink);
    color:var(--paper-deep);
    text-align:center;
    font-family:'Space Mono',monospace;
    font-size:11px;
    letter-spacing:0.08em;
    padding:22px 0 34px;
    opacity:0.6;
  }

  @media (prefers-reduced-motion: reduce){
    html{scroll-behavior:auto;}
    #burnRail .stick .burned{transition:none;}
  }
</style>
</head>
